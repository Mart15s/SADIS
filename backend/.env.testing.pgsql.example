APP_NAME="SAD System"
APP_ENV=testing
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL test database only. Do not point this file at a local or production database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sad_test
DB_USERNAME=postgres
DB_PASSWORD=PASSWORD
DB_URL=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BCRYPT_ROUNDS=4

PERENUAL_API_KEY=your_api_key_here
METEO_LT_BASE_URL=https://api.meteo.lt/v1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="SAD-Garden-System/1.0 (testing)"
