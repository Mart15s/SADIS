APP_NAME="Yava"
APP_ENV=testing
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL test database only. Do not point this file at a local or production database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=yava_test
DB_USERNAME=yava_test
DB_PASSWORD=yava_test_only
DB_URL=
# The Docker test service uses this password. A local disposable cluster using
# trust authentication accepts the same test configuration without a password.

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BCRYPT_ROUNDS=4
AUTH_EMIT_LEGACY_TOKEN=false

PERENUAL_API_KEY=your_api_key_here
METEO_LT_BASE_URL=https://api.meteo.lt/v1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="Yava/1.0 (testing)"
OTP_PROVIDER=development
OTP_DEVELOPMENT_CODE=123456
OTP_EXPIRES_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
