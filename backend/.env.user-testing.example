APP_NAME="Yava"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=yava_test
DB_USERNAME=yava_test
DB_PASSWORD=yava_test_only

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
AUTH_EMIT_LEGACY_TOKEN=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

OTP_PROVIDER=development
OTP_DEVELOPMENT_CODE=246810
OTP_EXPIRES_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

METEO_LT_BASE_URL=https://api.meteo.lt/v1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="Yava local user testing"

RUN_SCHEMA_MIGRATIONS=false
RUN_DEMO_SEEDER=false
RUN_DEMO1_RICH_SEEDER=false
