@startuml
title Asmeninio sodo ar daržo IS - abstraktus sistemos klasių modelis
left to right direction
skinparam packageStyle rectangle
skinparam linetype ortho

package "Sąsajos / Views" {
  package "Autentifikavimas ir naudotojai" {
    class LoginPage <<boundary>>
    class RegisterPage <<boundary>>
    class AccountPage <<boundary>>
    class AdminUsersPage <<boundary>>
    class AuthProvider <<boundary>>
  }
  package "Sklypo planas" {
    class PlotsPage <<boundary>>
    class PlotCreatePage <<boundary>>
    class PlotDetailPage <<boundary>>
    class PlotSharingPage <<boundary>>
    class PlotHistoryPage <<boundary>>
    class PlotRotationPage <<boundary>>
  }
  package "Augalai" {
    class PlantsPage <<boundary>>
    class PlantFormPage <<boundary>>
    class PlantDetailPage <<boundary>>
    class CatalogPlantFormPage <<boundary>>
  }
  package "Kalendorius ir resursai" {
    class PlotCalendarPage <<boundary>>
    class InventoryPage <<boundary>>
  }
  package "Bendruomenė ir ataskaitos" {
    class CommunityPage <<boundary>>
    class PlotAnalyticsPage <<boundary>>
    class PlotHarvestsPage <<boundary>>
  }
}

package "Valdikliai / Controllers" {
  class SignUpController <<control>>
  class LoginController <<control>>
  class PasswordResetController <<control>>
  class "User\\AccountController" as UserAccountController <<control>>
  class "Admin\\AccountController" as AdminAccountController <<control>>
  class PlotController <<control>>
  class SchemeController <<control>>
  class WorkspaceController <<control>>
  class ShareController <<control>>
  class PlantController <<control>>
  class CatalogPlantController <<control>>
  class PlantConditionController <<control>>
  class CalendarController <<control>>
  class TaskController <<control>>
  class InventoryController <<control>>
  class RotationController <<control>>
  class HistoryController <<control>>
  class HarvestController <<control>>
  class AnalyticsController <<control>>
  class CommunityController <<control>>
  class ExportController <<control>>
}

package "Paslaugos / Services" {
  class AccountService <<service>>
  class AdminService <<service>>
  class EmailServerBoundary <<service>>
  class AccessService <<service>>
  class PlotWorkspaceService <<service>>
  class PlotSnapshotService <<service>>
  class CatalogPlantService <<service>>
  class PlantCareService <<service>>
  class PerenualService <<service>>
  class PlantConditionHistoryService <<service>>
  class PlantLifecycleService <<service>>
  class CalendarGenerationService <<service>>
  class TaskCalendarService <<service>>
  class TaskWorkflowService <<service>>
  class WeatherService <<service>>
  class MeteoLtClient <<service>>
  class InventoryService <<service>>
  class TaskInventoryCoverageService <<service>>
  class RotationPlannerService <<service>>
  class HarvestService <<service>>
  class AnalyticsService <<service>>
  class CommunityService <<service>>
  class PdfExportService <<service>>
}

package "Esybės / Models" {
  class User <<entity>>
  class Profile <<entity>>
  class GardenOwner <<entity>>
  class AccessRight <<entity>>
  class Plot <<entity>>
  class PlantZone <<entity>>
  class Plant <<entity>>
  class CatalogPlant <<entity>>
  class PlantCare <<entity>>
  class PlantConditionHistory <<entity>>
  class TaskCalendar <<entity>>
  class Task <<entity>>
  class TaskResourceRequirement <<entity>>
  class WeatherForecast <<entity>>
  class InventoryItem <<entity>>
  class InventoryUsageLog <<entity>>
  class RotationHistory <<entity>>
  class RotationPlanDraft <<entity>>
  class PlotSnapshot <<entity>>
  class HarvestRecord <<entity>>
  class CommunityPost <<entity>>
  class AuditLog <<entity>>
}

package "Išorinės sistemos / External systems" {
  class "Meteo.lt API" as MeteoLtAPI <<external>>
  class "Perenual API" as PerenualAPI <<external>>
  class "Email server" as EmailServer <<external>>
  class "Nominatim reverse geocoding" as Nominatim <<external>>
  class "Dompdf PDF renderer" as Dompdf <<external>>
}

AuthProvider ..> SignUpController : REST /api/register
AuthProvider ..> LoginController : REST /api/login
AuthProvider ..> PasswordResetController : REST reset
AccountPage ..> UserAccountController : updates profile
AdminUsersPage ..> AdminAccountController : manages users

PlotsPage ..> PlotController : reads
PlotCreatePage ..> PlotController : creates
PlotCreatePage ..> WorkspaceController : commits draft
PlotDetailPage ..> PlotController : reads
PlotDetailPage ..> WorkspaceController : saves editor
PlotDetailPage ..> ExportController : downloads PDF
PlotSharingPage ..> ShareController : grants/revokes
PlotHistoryPage ..> HistoryController : reads versions
PlotRotationPage ..> RotationController : plans rotations

PlantsPage ..> PlantController : lists/deletes
PlantFormPage ..> PlantController : creates/updates
PlantDetailPage ..> PlantController : reads
PlantDetailPage ..> PlantConditionController : records condition
CatalogPlantFormPage ..> CatalogPlantController : catalog + Perenual

PlotCalendarPage ..> CalendarController : generates
PlotCalendarPage ..> TaskController : completes/rejects
InventoryPage ..> InventoryController : CRUD
CommunityPage ..> CommunityController : posts
PlotAnalyticsPage ..> AnalyticsController : analysis
PlotHarvestsPage ..> HarvestController : records harvest

UserAccountController ..> AccountService : uses
AdminAccountController ..> AdminService : uses
PasswordResetController ..> EmailServerBoundary : sends
PlotController ..> AccessService : authorizes
PlotController ..> PlotSnapshotService : snapshots
WorkspaceController ..> PlotWorkspaceService : commits
WorkspaceController ..> PlotSnapshotService : snapshots
ShareController ..> AccessService : access rights
PlantController ..> PlantCareService : links care
PlantController ..> CatalogPlantService : links catalog
CatalogPlantController ..> CatalogPlantService : persists
CatalogPlantController ..> PerenualService : searches
PlantConditionController ..> PlantConditionHistoryService : records
CalendarController ..> TaskCalendarService : generates
TaskCalendarService ..> CalendarGenerationService : delegates
CalendarGenerationService ..> WeatherService : fetches weather
CalendarGenerationService ..> InventoryService : plans inventory
CalendarGenerationService ..> PlantLifecycleService : lifecycle tasks
TaskController ..> TaskWorkflowService : workflow
TaskWorkflowService ..> InventoryService : consumes/restocks
InventoryController ..> InventoryService : manages stock
RotationController ..> RotationPlannerService : creates draft
HistoryController ..> PlotSnapshotService : reads history
HarvestController ..> HarvestService : records
AnalyticsController ..> AnalyticsService : calculates
CommunityController ..> CommunityService : feed/posts
ExportController ..> PdfExportService : renders

EmailServerBoundary ..> EmailServer : sends mail
WeatherService ..> MeteoLtClient : calls
MeteoLtClient ..> MeteoLtAPI : HTTP
PerenualService ..> PerenualAPI : HTTP
PdfExportService ..> Dompdf : renders PDF

User "1" -- "0..1" Profile : has
User "1" -- "0..1" GardenOwner : has
GardenOwner "1" -- "0..*" Plot : owns
Plot "1" -- "0..*" PlantZone : contains
Plot "1" -- "0..*" Plant : contains
PlantZone "1" -- "0..*" Plant : contains
Plant "0..*" -- "0..1" CatalogPlant : references
CatalogPlant "0..*" -- "0..1" PlantCare : uses
Plot "1" -- "0..*" TaskCalendar : has
TaskCalendar "1" -- "0..*" Task : contains
TaskCalendar "1" -- "0..*" WeatherForecast : stores
Task "1" -- "0..*" TaskResourceRequirement : requires
GardenOwner "1" -- "0..*" InventoryItem : owns
InventoryItem "1" -- "0..*" InventoryUsageLog : logs
Plot "1" -- "0..*" RotationHistory : records
Plot "1" -- "0..*" RotationPlanDraft : drafts
Plot "1" -- "0..*" PlotSnapshot : snapshots
Plot "1" -- "0..*" HarvestRecord : harvests
Plot "1" -- "0..*" CommunityPost : posts
Plot "1" -- "0..*" AccessRight : grants
User "1" -- "0..*" AuditLog : admin actions

@enduml
