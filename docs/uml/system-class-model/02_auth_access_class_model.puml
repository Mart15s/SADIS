@startuml
title Autentifikavimo, profilio, administravimo ir prieigos teisių klasių modelis
left to right direction
skinparam packageStyle rectangle

package "Sąsajos / Views" {
  class LoginPage <<boundary>> {
    +handleSubmit(event)
  }
  class RegisterPage <<boundary>> {
    +handleSubmit(event)
  }
  class ForgotPasswordPage <<boundary>> {
    +handleSubmit(event)
  }
  class ResetPasswordPage <<boundary>> {
    +handleSubmit(event)
  }
  class AccountPage <<boundary>> {
    +handleSubmit(event)
  }
  class AdminUsersPage <<boundary>> {
    +handleInspect(userId)
    +handleRoleChange(userId, nextRole)
    +handleDelete(userId)
  }
  class AuthProvider <<boundary>> {
    +restoreSession()
    +login(credentials)
    +register(profileData)
    +updateAccount(accountData)
    +logout()
  }
  class ProtectedRoute <<boundary>>
  class AdminRoute <<boundary>>
}

package "Valdikliai / Controllers" {
  class SignUpController <<control>> {
    +store(request)
  }
  class LoginController <<control>> {
    +store(request)
  }
  class LogoutController <<control>> {
    +destroy(request)
  }
  class PasswordResetController <<control>> {
    +forgot(request)
    +reset(request)
  }
  class CurrentUserController <<control>> {
    +show(request)
  }
  class "User\\AccountController" as UserAccountController <<control>> {
    +update(request)
  }
  class "Admin\\AccountController" as AdminAccountController <<control>> {
    +index(request, service)
    +show(user, service)
    +updateRole(request, user, service)
    +destroy(user, service)
  }
  class AuditLogController <<control>> {
    +index(request)
  }
  class AdminMiddleware <<control>> {
    +handle(request, next)
  }
}

package "Užklausos / Requests" {
  class UpdateAccountRequest <<request>> {
    +authorize()
    +rules()
  }
  class UpdateUserRoleRequest <<request>> {
    +authorize()
    +rules()
  }
}

package "Ištekliai / Resources" {
  class AuthenticatedUserResource <<resource>> {
    +toArray(request)
  }
  class "Admin\\UserResource" as AdminUserResource <<resource>> {
    +toArray(request)
  }
}

package "Paslaugos / Services" {
  class AccountService <<service>> {
    +updateAccount(user, data)
  }
  class AdminService <<service>> {
    +listUsers(filters)
    +getUser(id)
    +updateUserRole(user, role)
    +deleteUser(user)
  }
  class EmailServerBoundary <<service>> {
    +sendPasswordResetLink(user, token)
  }
  class AccessService <<service>> {
    +sharePlot(grantor, plot, recipient, role)
    +revokeAccess(grantor, plot, recipient)
    +revokeAccessRight(grantor, accessRight)
    +getUserRoleForPlot(owner, plot)
    +userHasAccess(owner, plot)
    +userCanEdit(owner, plot)
    +userIsOwner(owner, plot)
    +accessiblePlotIds(owner)
  }
}

package "Esybės / Models" {
  class User <<entity>> {
    +email
    +password
    +reset_code
    +role
    +gardenOwner()
    +profile()
    +grantedAccessRights()
    +receivedAccessRights()
    +communityPosts()
  }
  class Profile <<entity>> {
    +user_id
    +name
    +surname
    +last_login
    +user()
    +gardenOwner()
  }
  class GardenOwner <<entity>> {
    +id
    +user_id
    +id_user
    +fk_profile_id
    +user()
    +profile()
    +ownedPlots()
    +ownedInventoryItems()
    +grantedAccessRights()
    +receivedAccessRights()
  }
  class AccessRight <<entity>> {
    +granted_at
    +role
    +garden_owner_id
    +plot_id
    +fk_plot_id
    +plot()
    +grantor()
    +recipient()
  }
  class Plot <<entity>> {
    +name
    +garden_owner_id
    +accessRights()
    +gardenOwner()
  }
  class AuditLog <<entity>> {
    +admin_user_id
    +action
    +target_user_id
    +context
    +admin()
    +targetUser()
  }
}

package "Išorinės sistemos / External systems" {
  class "Laravel Sanctum tokens" as Sanctum <<external>>
  class "Email server" as EmailServer <<external>>
}

LoginPage ..> AuthProvider : login()
RegisterPage ..> AuthProvider : register()
AccountPage ..> AuthProvider : updateAccount()
ForgotPasswordPage ..> PasswordResetController : /forgot-password
ResetPasswordPage ..> PasswordResetController : /reset-password
AdminUsersPage ..> AdminAccountController : admin REST
ProtectedRoute ..> AuthProvider : checks session
AdminRoute ..> AuthProvider : checks role

AuthProvider ..> CurrentUserController : getMe()
AuthProvider ..> LoginController : login()
AuthProvider ..> SignUpController : register()
AuthProvider ..> LogoutController : logout()
AuthProvider ..> UserAccountController : updateMe()

SignUpController ..> User : creates
SignUpController ..> Profile : creates
SignUpController ..> GardenOwner : creates
SignUpController ..> Sanctum : creates token
LoginController ..> User : authenticates
LoginController ..> Profile : updates last_login
LoginController ..> Sanctum : creates token
LogoutController ..> Sanctum : deletes token
PasswordResetController ..> EmailServerBoundary : sends link
EmailServerBoundary ..> EmailServer : sends mail
UserAccountController ..> UpdateAccountRequest : validates
UserAccountController ..> AccountService : updates
UserAccountController ..> AuthenticatedUserResource : returns
AdminMiddleware ..> User : checks admin role
AdminAccountController ..> UpdateUserRoleRequest : validates
AdminAccountController ..> AdminService : delegates
AdminAccountController ..> AdminUserResource : returns
AdminService ..> User : manages
AdminService ..> AuditLog : records
AccessService ..> AccessRight : creates/deletes
AccessService ..> Plot : checks ownership

User "1" -- "0..1" Profile : has
User "1" -- "0..1" GardenOwner : has
GardenOwner "1" -- "0..*" Plot : owns
Plot "1" -- "0..*" AccessRight : grants
GardenOwner "1" -- "0..*" AccessRight : receives
User "1" -- "0..*" AuditLog : admin
User "1" -- "0..*" AuditLog : target

@enduml
