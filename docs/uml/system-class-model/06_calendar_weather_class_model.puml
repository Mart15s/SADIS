@startuml
title Rekomendacinio kalendoriaus, užduočių ir Meteo.lt orų klasių modelis
left to right direction
skinparam packageStyle rectangle

package "Sąsajos / Views" {
  class PlotCalendarPage <<boundary>> {
    +handleGenerate(event)
    +handleTaskAction(taskId, action)
    +handleDayClick(day)
  }
}

package "Valdikliai / Controllers" {
  class CalendarController <<control>> {
    +index(request, plot, accessService)
    +store(request, plot, service, inventoryService, accessService)
    +show(request, plot, calendar, accessService, inventoryService)
  }
  class TaskController <<control>> {
    +index(request, calendar, accessService, inventoryService)
    +complete(request, task, service, accessService)
    +reject(request, task, service, accessService)
  }
}

package "Užklausos / Requests" {
  class GenerateCalendarRequest <<request>> {
    +authorize()
    +rules()
    +after()
  }
  class ListCalendarTasksRequest <<request>> {
    +authorize()
    +rules()
  }
  class CompleteTaskRequest <<request>> {
    +authorize()
    +rules()
  }
  class RejectTaskRequest <<request>> {
    +authorize()
    +rules()
  }
}

package "Ištekliai / Resources" {
  class TaskCalendarListResource <<resource>> {
    +toArray(request)
  }
  class TaskCalendarResource <<resource>> {
    +toArray(request)
  }
  class TaskResource <<resource>> {
    +toArray(request)
  }
  class WeatherForecastResource <<resource>> {
    +toArray(request)
  }
  class TaskResourceRequirementResource <<resource>> {
    +toArray(request)
  }
}

package "Paslaugos / Services" {
  class AccessService <<service>>
  class TaskCalendarService <<service>> {
    +generate(plot, start, end)
  }
  class CalendarGenerationService <<service>> {
    +generateCalendar(plot, startDate, endDate)
  }
  class WeatherService <<service>> {
    +getForecastRange(city, start, end)
    +debugForecast(city)
  }
  class MeteoLtClient <<service>> {
    +findPlaceByCity(city)
    +getLongTermForecast(placeCode)
  }
  class InventoryService <<service>> {
    +buildPlanningLedger(owner)
    +attachLiveTaskInventory(owner, tasks)
    +assertTaskCanBeCompletedForDay(owner, task, dayTasks)
    +consumeTaskRequirements(owner, task)
    +replenishFromTask(owner, task)
  }
  class TaskInventoryCoverageService <<service>> {
    +buildPlanningLedger(owner)
    +reserveRequirementForPlan(ledger, requirement)
    +summarizeTasksByDate(owner, tasks, lock)
    +buildDayRequirementSummaries(owner, primaryPendingTasks, buyTasks, lock)
  }
  class PlantCareService <<service>> {
    +resolveEffectivePlantCare(plant, speciesId)
  }
  class PlantLifecyclePhaseService <<service>> {
    +resolveSimulatedPhase(plant, care, forDate)
  }
  class PlantLifecycleService <<service>> {
    +buildActionsForDate(plant, care, phaseResult, generationDate, conditionHistory, harvestRecords)
  }
  class TaskWorkflowService <<service>> {
    +complete(task, materialsUsed, conditionReview, harvest)
    +reject(task, reason)
  }
}

package "Esybės / Models" {
  class Plot <<entity>> {
    +city
    +taskCalendars()
    +plants()
  }
  class Plant <<entity>> {
    +plant_date
    +condition
    +conditionHistory()
    +harvestRecords()
    +effectivePlantCare()
  }
  class PlantCare <<entity>> {
    +watering_interval_days
    +fertilizing_interval_days
    +pest_check_interval_days
    +rain_skip_threshold_mm
    +frost_temp_threshold_c
    +heat_extra_water_temp_c
    +wind_protection_kmh
  }
  class TaskCalendar <<entity>> {
    +creation_date
    +start_date
    +end_date
    +plot_id
    +tasks()
    +weatherForecasts()
  }
  class Task <<entity>> {
    +date
    +name
    +task_type
    +priority
    +reason
    +comment
    +weather_context
    +inventory_context
    +simulated_state
    +workflow_context
    +state
    +status
    +taskCalendar()
    +plant()
    +plantZone()
    +requiredResources()
  }
  class TaskResourceRequirement <<entity>> {
    +resource_name
    +normalized_name
    +inventory_item_type
    +unit
    +required_quantity
    +shortage_quantity
    +is_consumed
    +task()
  }
  class WeatherForecast <<entity>> {
    +date
    +temperature
    +temp_min
    +temp_max
    +precipitation
    +humidity
    +wind_kmh
    +condition_code
    +is_seasonal_fallback
    +source
    +source_city
    +taskCalendar()
  }
}

package "Išorinės sistemos / External systems" {
  class "Meteo.lt API" as MeteoLtAPI <<external>>
}

PlotCalendarPage ..> CalendarController : list/generate/show
PlotCalendarPage ..> TaskController : list/complete/reject
CalendarController ..> GenerateCalendarRequest : validates
CalendarController ..> AccessService : authorizes
CalendarController ..> TaskCalendarService : generate()
CalendarController ..> InventoryService : hydrate live inventory
CalendarController ..> TaskCalendarResource : returns
TaskController ..> ListCalendarTasksRequest : validates
TaskController ..> CompleteTaskRequest : validates
TaskController ..> RejectTaskRequest : validates
TaskController ..> AccessService : authorizes
TaskController ..> InventoryService : live inventory
TaskController ..> TaskWorkflowService : complete/reject
TaskController ..> TaskResource : returns

TaskCalendarService ..> CalendarGenerationService : delegates
CalendarGenerationService ..> WeatherService : getForecastRange()
CalendarGenerationService ..> PlantCareService : resolve care
CalendarGenerationService ..> PlantLifecyclePhaseService : simulate phase
CalendarGenerationService ..> PlantLifecycleService : lifecycle tasks
CalendarGenerationService ..> InventoryService : planning ledger
CalendarGenerationService ..> TaskInventoryCoverageService : day coverage
CalendarGenerationService ..> TaskCalendar : creates
CalendarGenerationService ..> Task : creates
CalendarGenerationService ..> TaskResourceRequirement : creates
CalendarGenerationService ..> WeatherForecast : persists
WeatherService ..> MeteoLtClient : calls
WeatherService ..> WeatherForecast : fallback reads
MeteoLtClient ..> MeteoLtAPI : HTTP /places, /forecasts
TaskWorkflowService ..> InventoryService : consumes/restocks

Plot "1" -- "0..*" TaskCalendar : has
TaskCalendar "1" -- "0..*" Task : contains
TaskCalendar "1" -- "0..*" WeatherForecast : stores
Task "1" -- "0..*" TaskResourceRequirement : requires
Task "0..*" -- "0..1" Plant : for plant
Plant "0..*" -- "0..1" PlantCare : effective care

@enduml
